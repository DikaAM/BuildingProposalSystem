@model BuildingProposalSystem.Models.ViewModels.ProposalEditViewModel

@{
    ViewData["Title"] = "Edit Proposal";

    var isReadOnly = !Model.CanEdit;
}

<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      crossorigin="" />

<style>
    #proposalMap {
        height: 400px;
        width: 100%;
        border-radius: 8px;
        overflow: hidden;
    }

        #proposalMap .leaflet-container {
            height: 100%;
            width: 100%;
        }

    .current-file {
        padding: 12px 16px;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        background-color: #f8f9fa;
    }

    .current-file-name {
        font-weight: 500;
    }

    .current-file-info {
        font-size: 0.875rem;
        color: #6c757d;
    }

    .status-badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 500;
    }

    .rejection-box {
        padding: 14px 16px;
        border: 1px solid #dc3545;
        border-radius: 6px;
        background-color: #fff5f5;
    }

    .rejection-title {
        font-weight: 600;
        color: #dc3545;
        margin-bottom: 6px;
    }

    .rejection-reason {
        color: #495057;
        white-space: pre-wrap;
    }
</style>


<div class="page-header">

    <div>
        <h1 class="page-header-title">
            @(Model.CanEdit ? "Edit Proposal" : "Detail Proposal")
        </h1>

        <p class="page-header-subtitle">
            @(Model.CanEdit
                ? "Ubah informasi proposal sebelum dikirim ke Manager."
                : "Lihat informasi dan status proposal.")
        </p>
    </div>

    <div>
        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Kembali
        </a>
    </div>

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success page-alert">
        @TempData["SuccessMessage"]
    </div>
}


@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger page-alert">
        @TempData["ErrorMessage"]
    </div>
}


<div class="content-card">

    <div class="content-card-header">

        <div>
            <h2>
                @Model.ProposalNumber
            </h2>

            <p>
                Status:
                <span class="status-badge">
                    @Model.Status
                </span>
            </p>
        </div>

    </div>


    <div class="content-card-body">

        <form asp-action="Edit"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <input asp-for="Id" type="hidden" />

            <input asp-for="ProposalNumber"
                   type="hidden" />

            <input asp-for="Status"
                   type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"
                 role="alert">
            </div>


            @if (Model.IsRejected &&
                 !string.IsNullOrWhiteSpace(Model.RejectionReason))
            {
                <div class="form-section">

                    <div class="rejection-box">

                        <div class="rejection-title">
                            Proposal Ditolak
                        </div>

                        <div class="rejection-reason">
                            @Model.RejectionReason
                        </div>

                    </div>

                </div>
            }


            <!-- ===================================================== -->
            <!-- INFORMASI DASAR -->
            <!-- ===================================================== -->

            <div class="form-section">

                <div class="form-section-title">
                    Informasi Dasar
                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Nomor Proposal
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.ProposalNumber"
                           readonly />

                </div>


                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="ProposalDate"
                               class="form-label">
                        </label>

                        <input asp-for="ProposalDate"
                               type="date"
                               class="form-control"
                               readonly="@isReadOnly" />

                        <span asp-validation-for="ProposalDate"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="BuildingName"
                               class="form-label">
                        </label>

                        <input asp-for="BuildingName"
                               class="form-control"
                               placeholder="Masukkan nama gedung"
                               readonly="@isReadOnly" />

                        <span asp-validation-for="BuildingName"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>


            <!-- ===================================================== -->
            <!-- LOKASI -->
            <!-- ===================================================== -->

            <div class="form-section">

                <div class="form-section-title">
                    Lokasi
                </div>


                <div class="mb-3">

                    <label asp-for="Address"
                           class="form-label">
                    </label>

                    <textarea asp-for="Address"
                              class="form-control"
                              rows="3"
                              placeholder="Masukkan alamat lengkap lokasi pembangunan"
                              readonly="@isReadOnly"></textarea>

                    <span asp-validation-for="Address"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Lokasi Pada Map
                    </label>

                    <div id="proposalMap"></div>

                    <div class="form-text mt-2">
                        @if (Model.CanEdit)
                        {
                            @:Klik map atau geser marker untuk mengubah lokasi proposal.
                        }
                        else
                        {
                            @:Lokasi proposal.
                        }
                    </div>

                </div>


                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Latitude"
                               class="form-label">
                        </label>

                        <input asp-for="Latitude"
                               id="latitudeInput"
                               class="form-control"
                               type="number"
                               step="any"
                               readonly="@isReadOnly" />

                        <span asp-validation-for="Latitude"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="Longitude"
                               class="form-label">
                        </label>

                        <input asp-for="Longitude"
                               id="longitudeInput"
                               class="form-control"
                               type="number"
                               step="any"
                               readonly="@isReadOnly" />

                        <span asp-validation-for="Longitude"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>


            <!-- ===================================================== -->
            <!-- DETAIL PROPOSAL -->
            <!-- ===================================================== -->

            <div class="form-section">

                <div class="form-section-title">
                    Detail Proposal
                </div>


                <div class="mb-3">

                    <label asp-for="EstimatedCost"
                           class="form-label">
                    </label>

                    <input asp-for="EstimatedCost"
                           class="form-control"
                           type="number"
                           step="0.01"
                           min="0"
                           placeholder="Masukkan estimasi biaya"
                           readonly="@isReadOnly" />

                    <span asp-validation-for="EstimatedCost"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label">
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="5"
                              placeholder="Jelaskan detail proposal pembangunan"
                              readonly="@isReadOnly"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <!-- ===================================================== -->
            <!-- DOKUMEN PROPOSAL -->
            <!-- ===================================================== -->

            <div class="form-section">

                <div class="form-section-title">
                    Dokumen Proposal
                </div>


                @if (Model.Attachments != null &&
                     Model.Attachments.Any())
                {
                    <div class="mb-3">

                        <label class="form-label">
                            File Proposal Saat Ini
                        </label>

                        @foreach (var attachment in Model.Attachments)
                        {
                            <div class="current-file mb-2">

                                <div class="current-file-name">
                                    <a asp-controller="Proposal"
                                       asp-action="DownloadAttachment"
                                       asp-route-id="@attachment.Id"
                                       class="text-decoration-none">
                                        @attachment.OriginalFileName
                                    </a>
                                </div>

                                <div class="current-file-info">
                                    @(attachment.FileSize / 1024) KB
                                    |
                                    @attachment.UploadedDate.ToLocalTime().ToString("dd/MM/yyyy")
                                </div>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="alert alert-secondary">
                        Belum ada file proposal PDF.
                    </div>
                }


                @if (Model.CanEdit)
                {
                    <div class="mb-3">

                        <label asp-for="ProposalFile"
                               class="form-label">
                        </label>

                        <input asp-for="ProposalFile"
                               id="proposalFile"
                               type="file"
                               class="form-control"
                               accept=".pdf,application/pdf" />

                        <div class="form-text">
                            Pilih PDF baru jika ingin menambahkan atau mengganti dokumen proposal.
                        </div>

                        <div id="selectedFileName"
                             class="form-text">
                        </div>

                        <span asp-validation-for="ProposalFile"
                              class="text-danger">
                        </span>

                    </div>
                }

            </div>


            <!-- ===================================================== -->
            <!-- APPROVAL -->
            <!-- ===================================================== -->
            @if (Model.CanApprove)
            {
                <div class="form-section">

                    <div class="form-section-title">
                        Approval
                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Keputusan
                        </label>

                        <div class="d-flex gap-4">

                            <div class="form-check">

                                <input class="form-check-input"
                                       type="radio"
                                       name="approvalAction"
                                       id="approvalApprove"
                                       value="Approve" />

                                <label class="form-check-label"
                                       for="approvalApprove">
                                    Approve
                                </label>

                            </div>


                            <div class="form-check">

                                <input class="form-check-input"
                                       type="radio"
                                       name="approvalAction"
                                       id="approvalReject"
                                       value="Reject" />

                                <label class="form-check-label"
                                       for="approvalReject">
                                    Reject
                                </label>

                            </div>

                        </div>

                        <span id="approvalActionError"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-3">

                        <label asp-for="ApprovalComment"
                               class="form-label">
                            Komentar
                        </label>

                        <textarea asp-for="ApprovalComment"
                                  id="approvalComment"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Masukkan komentar approval atau alasan reject"></textarea>

                        <span id="approvalCommentError"
                              class="text-danger">
                        </span>

                    </div>

                </div>
            }


            <!-- ===================================================== -->
            <!-- ACTION -->
            <!-- ===================================================== -->

            <div class="form-actions">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Kembali
                </a>


                @if (Model.CanApprove)
                {
                    <button type="submit"
                            formaction="@Url.Action("Approval", "Proposal")"
                            formmethod="post"
                            class="btn btn-primary"
                            id="btnApprovalSubmit">
                        Submit Approval
                    </button>
                }
                else if (Model.CanEdit)
                {
                    <button type="submit"
                            name="Action"
                            value="Draft"
                            class="btn btn-outline-primary">
                        Simpan Draft
                    </button>

                    <button type="submit"
                            name="Action"
                            value="Submit"
                            class="btn btn-primary">
                        Submit Pengajuan
                    </button>
                }

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            crossorigin="">
    </script>


    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const latitudeInput =
                document.getElementById("latitudeInput");

            const longitudeInput =
                document.getElementById("longitudeInput");

            const mapElement =
                document.getElementById("proposalMap");


            if (!latitudeInput ||
                !longitudeInput ||
                !mapElement) {
                return;
            }


            const latitude =
                parseFloat(latitudeInput.value);

            const longitude =
                parseFloat(longitudeInput.value);


            const hasLocation =
                !isNaN(latitude) &&
                !isNaN(longitude) &&
                latitude !== 0 &&
                longitude !== 0;


            const defaultLatitude = -6.2000000;
            const defaultLongitude = 106.8166667;


            const initialLatitude =
                hasLocation
                    ? latitude
                    : defaultLatitude;


            const initialLongitude =
                hasLocation
                    ? longitude
                    : defaultLongitude;


            const initialZoom =
                hasLocation
                    ? 16
                    : 11;


            const map =
                L.map(mapElement).setView(
                    [
                        initialLatitude,
                        initialLongitude
                    ],
                    initialZoom
                );


            L.tileLayer(
                "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
                {
                    maxZoom: 19,

                    attribution:
                        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
                }
            ).addTo(map);


            let marker = null;


            const canEdit =
                @Model.CanEdit.ToString().ToLower();


            function setLocation(
                latitude,
                longitude,
                moveMap = true) {

                latitude =
                    parseFloat(latitude);

                longitude =
                    parseFloat(longitude);


                if (isNaN(latitude) ||
                    isNaN(longitude)) {
                    return;
                }


                if (latitude < -90 ||
                    latitude > 90) {
                    return;
                }


                if (longitude < -180 ||
                    longitude > 180) {
                    return;
                }


                if (canEdit) {

                    latitudeInput.value =
                        latitude.toFixed(7);

                    longitudeInput.value =
                        longitude.toFixed(7);

                }


                if (marker === null) {

                    marker =
                        L.marker(
                            [
                                latitude,
                                longitude
                            ],
                            {
                                draggable: canEdit
                            }
                        ).addTo(map);


                    if (canEdit) {

                        marker.on(
                            "dragend",
                            function () {

                                const position =
                                    marker.getLatLng();

                                setLocation(
                                    position.lat,
                                    position.lng,
                                    false
                                );

                            }
                        );

                    }

                }
                else {

                    marker.setLatLng(
                        [
                            latitude,
                            longitude
                        ]
                    );

                }


                if (moveMap) {

                    map.setView(
                        [
                            latitude,
                            longitude
                        ],
                        Math.max(
                            map.getZoom(),
                            15
                        )
                    );

                }

            }


            if (hasLocation) {

                setLocation(
                    latitude,
                    longitude,
                    false
                );

            }


            if (canEdit) {

                map.on(
                    "click",
                    function (event) {

                        setLocation(
                            event.latlng.lat,
                            event.latlng.lng
                        );

                    }
                );


                latitudeInput.addEventListener(
                    "change",
                    function () {

                        const lat =
                            parseFloat(
                                latitudeInput.value
                            );

                        const lng =
                            parseFloat(
                                longitudeInput.value
                            );

                        if (!isNaN(lat) &&
                            !isNaN(lng)) {

                            setLocation(
                                lat,
                                lng
                            );

                        }

                    }
                );


                longitudeInput.addEventListener(
                    "change",
                    function () {

                        const lat =
                            parseFloat(
                                latitudeInput.value
                            );

                        const lng =
                            parseFloat(
                                longitudeInput.value
                            );

                        if (!isNaN(lat) &&
                            !isNaN(lng)) {

                            setLocation(
                                lat,
                                lng
                            );

                        }

                    }
                );

            }


            setTimeout(
                function () {

                    map.invalidateSize();

                },
                100
            );

        });

    </script>


    @if (Model.CanEdit)
    {
        <script>

            document.addEventListener(
                "DOMContentLoaded",
                function () {

                    const proposalFile =
                        document.getElementById(
                            "proposalFile"
                        );

                    const selectedFileName =
                        document.getElementById(
                            "selectedFileName"
                        );


                    if (!proposalFile ||
                        !selectedFileName) {
                        return;
                    }


                    proposalFile.addEventListener(
                        "change",
                        function () {

                            if (this.files &&
                                this.files.length > 0) {

                                selectedFileName.textContent =
                                    "File baru: " +
                                    this.files[0].name;

                            }
                            else {

                                selectedFileName.textContent =
                                    "";

                            }

                        }
                    );

                }
            );

        </script>
    }


    @if (Model.CanApprove)
    {
        <script>

            document.addEventListener(
                "DOMContentLoaded",
                function () {

                    const approvalSubmit =
                        document.getElementById(
                            "btnApprovalSubmit"
                        );


                    if (!approvalSubmit) {
                        return;
                    }


                    approvalSubmit.addEventListener(
                        "click",
                        function (event) {

                            const selectedAction =
                                document.querySelector(
                                    'input[name="approvalAction"]:checked'
                                );


                            const comment =
                                document.getElementById(
                                    "approvalComment"
                                );


                            const actionError =
                                document.getElementById(
                                    "approvalActionError"
                                );


                            const commentError =
                                document.getElementById(
                                    "approvalCommentError"
                                );


                            actionError.textContent =
                                "";

                            commentError.textContent =
                                "";


                            if (!selectedAction) {

                                event.preventDefault();

                                actionError.textContent =
                                    "Silakan pilih Approve atau Reject.";

                                return;
                            }


                            if (!comment ||
                                !comment.value.trim()) {

                                event.preventDefault();

                                commentError.textContent =
                                    "Komentar wajib diisi.";

                                return;
                            }

                        }
                    );

                }
            );

        </script>
    }

}
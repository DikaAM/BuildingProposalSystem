@{
    ViewData["Title"] = "Password Berhasil Direset";
}

<div class="reset-success-page">

    <div class="reset-success-card">

        <div class="reset-success-header">

            <div class="reset-success-status">
                Berhasil
            </div>

            <h1>Password Berhasil Direset</h1>

            <p>
                Password kamu sudah berhasil diubah.
                Silakan login menggunakan password baru.
            </p>

        </div>


        <a asp-controller="Account"
           asp-action="Login"
           class="btn btn-primary reset-success-button">

            Ke Halaman Login

        </a>

    </div>

</div>
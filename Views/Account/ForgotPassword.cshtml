@model BuildingProposalSystem.Models.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Lupa Password";
}

<div class="forgot-password-page">

    <div class="forgot-password-card">

        <div class="forgot-password-header">

            <div class="forgot-password-logo">
                <i class="bi bi-shield-lock"></i>
            </div>

            <h1>Lupa Password?</h1>

            <p>
                Masukkan email yang terdaftar untuk mendapatkan link reset password.
            </p>

        </div>


        @if (ViewBag.Message != null)
        {
            <div class="forgot-password-success">

                <div class="success-title">
                    Link Reset Password Terkirim
                </div>

                <div class="success-message">
                    @ViewBag.Message
                </div>

            </div>

            <a asp-action="Login"
               class="btn btn-primary forgot-password-button">

                Kembali ke Login

            </a>
        }
        else
        {
            <form asp-action="ForgotPassword" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert">
                </div>


                <div class="forgot-password-form-group">

                    <label asp-for="Email">
                        Email
                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Masukkan email Anda"
                           autocomplete="email" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>


                <button type="submit"
                        class="btn btn-primary forgot-password-button">

                    Kirim Link Reset

                </button>

            </form>


            <div class="forgot-password-back">

                <a asp-action="Login">
                    Kembali ke Login
                </a>

            </div>
        }

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

} 
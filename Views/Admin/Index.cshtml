@model List<BuildingProposalSystem.Models.ViewModels.UserListItemViewModel>

@{
    ViewData["Title"] = "User Management";
}

<div class="page-header">
    <div>
        <h1 class="page-header-title">User Management</h1>
        <p class="page-header-subtitle">
            Kelola pengguna, role, dan status akun.
        </p>
    </div>

    <div>
        <a asp-action="Create" class="btn btn-primary">
            Tambah User
        </a>
    </div>
</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success page-alert">
        @TempData["SuccessMessage"]
    </div>
}


<div class="content-card">

    <div class="content-card-header">

        <div>
            <h2>Daftar User</h2>
            <p>
                Daftar seluruh user yang terdaftar pada sistem.
            </p>
        </div>

        <div class="user-count">
            @Model.Count User
        </div>

    </div>


    <div class="table-responsive">

        <table id="userTable" class="table user-management-table">

            <thead>
                <tr>
                    <th>Nama Lengkap</th>
                    <th>Email</th>
                    <th>Username</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th class="text-center">Aksi</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Any())
                {
                    @foreach (var user in Model)
                    {
                        <tr>

                            <td>
                                <div class="user-name-cell">
                                    <div class="table-user-avatar">
                                        @(string.IsNullOrWhiteSpace(user.FullName)
                                            ? "?"
                                            : user.FullName.Substring(0, 1).ToUpper())
                                    </div>

                                    <div>
                                        <div class="table-user-name">
                                            @user.FullName
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <td>
                                @user.Email
                            </td>

                            <td>
                                <span class="username-text">
                                    @user.UserName
                                </span>
                            </td>

                            <td>
                                <div class="role-list">
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="role-badge">
                                            @role
                                        </span>
                                    }
                                </div>
                            </td>

                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="status-badge status-active">
                                        Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-inactive">
                                        Nonaktif
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="user-actions">

                                    <a asp-action="Edit"
                                       asp-route-id="@user.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-action="ResetPassword"
                                       asp-route-id="@user.Id"
                                       class="btn btn-sm btn-outline-warning">
                                        Reset Password
                                    </a>

                                    <form asp-action="ToggleActive"
                                          asp-route-id="@user.Id"
                                          method="post">

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-secondary">
                                            @(user.IsActive
                                                ? "Nonaktifkan"
                                                : "Aktifkan")
                                        </button>

                                    </form>

                                </div>
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <div class="empty-state">
                                <div class="empty-state-title">
                                    Belum Ada User
                                </div>

                                <p>
                                    Belum ada user yang terdaftar di dalam sistem.
                                </p>

                                <a asp-action="Create"
                                   class="btn btn-primary">
                                    Tambah User
                                </a>
                            </div>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

@section Scripts {

    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {

        $('#userTable').DataTable({
        pageLength: 10,

        lengthMenu: [
        [5, 10, 25, 50, 100],
        [5, 10, 25, 50, 100]
        ],

        ordering: true,

        order: [
        [0, 'asc']
        ],

        columnDefs: [
        {
        orderable: false,
        targets: 5
        }
        ],

        language: {
        search: "Search:",
        lengthMenu: "Show _MENU_ entries",
        info: "Showing _START_ to _END_ of _TOTAL_ entries",
        infoEmpty: "Showing 0 to 0 of 0 entries",
        zeroRecords: "Data tidak ditemukan",
        emptyTable: "Belum ada data user",
        paginate: {
        first: "First",
        last: "Last",
        next: "›",
        previous: "‹"
        }
        }

        });

        });
    </script>
}
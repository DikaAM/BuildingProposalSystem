@using Microsoft.AspNetCore.Identity

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Building Proposal System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BuildingProposalSystem.styles.css" asp-append-version="true" />

</head>

<body>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="app-wrapper">

            <!-- SIDEBAR -->
            <aside class="sidebar">

                <div class="sidebar-brand">
                    <div class="brand-icon">
                        <i class="bi bi-building"></i>
                    </div>

                    <div>
                        <div class="brand-title">Building</div>
                        <div class="brand-subtitle">Proposal System</div>
                    </div>
                </div>

                <div class="sidebar-menu">

                    <div class="menu-section">
                        MAIN
                    </div>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="sidebar-link">

                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Dashboard</span>
                    </a>


                    @if (User.IsInRole("Staff") || User.IsInRole("Admin"))
                    {
                        <div class="menu-section">
                            PROPOSAL
                        </div>

                        <a asp-controller="Proposal"
                           asp-action="Index"
                           class="sidebar-link">

                            <i class="bi bi-file-earmark-text"></i>
                            <span>Proposal Building</span>
                        </a>
                    }


                    @if (User.IsInRole("Manager") || User.IsInRole("Direktur") || User.IsInRole("Admin"))
                    {
                        <div class="menu-section">
                            APPROVAL
                        </div>

                        <a asp-controller="Approval"
                           asp-action="Index"
                           class="sidebar-link">

                            <i class="bi bi-check2-square"></i>
                            <span>Approval Pengajuan</span>
                        </a>

                        <a asp-controller="Approval"
                           asp-action="History"
                           class="sidebar-link">

                            <i class="bi bi-clock-history"></i>
                            <span>Riwayat Approval</span>
                        </a>
                    }


                    @if (User.IsInRole("Admin"))
                    {
                        <div class="menu-section">
                            ADMINISTRATION
                        </div>

                        <a asp-controller="Admin"
                           asp-action="Index"
                           class="sidebar-link">

                            <i class="bi bi-people"></i>
                            <span>User Management</span>
                        </a>

                        <a asp-controller="Roles"
                           asp-action="Index"
                           class="sidebar-link">

                            <i class="bi bi-person-badge"></i>
                            <span>Role Management</span>
                        </a>
                    }

                </div>


                

            </aside>


            <!-- MAIN AREA -->
            <div class="main-wrapper">

                <!-- TOPBAR -->
                <header class="topbar">

                    <div class="topbar-left">

                        <button class="sidebar-toggle"
                                type="button"
                                id="sidebarToggle">

                            <i class="bi bi-list"></i>

                        </button>

                        <div>
                            <div class="page-title">
                                @ViewData["Title"]
                            </div>

                            <div class="page-subtitle">
                                Building Proposal Management System
                            </div>
                        </div>

                    </div>


                    <div class="topbar-right">

                        @{
                            var username = User.Identity?.Name ?? "User";
                            var initial = username.Substring(0, 1).ToUpper();

                            var roleName = "User";

                            if (User.IsInRole("Admin"))
                            {
                                roleName = "Administrator";
                            }
                            else if (User.IsInRole("Staff"))
                            {
                                roleName = "Staff";
                            }
                            else if (User.IsInRole("Manager"))
                            {
                                roleName = "Manager";
                            }
                            else if (User.IsInRole("Direktur"))
                            {
                                roleName = "Direktur";
                            }
                        }

                        <div class="dropdown user-dropdown">

                            <button class="user-dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">

                                <div class="user-avatar">
                                    @initial
                                </div>

                                <div class="user-details">

                                    <div class="user-name">
                                        @username
                                    </div>

                                    <div class="user-role">
                                        @roleName
                                    </div>

                                </div>

                                <span class="user-dropdown-arrow">
                                    <i class="bi bi-chevron-down"></i>
                                </span>

                            </button>


                            <div class="dropdown-menu dropdown-menu-end user-dropdown-menu">

                                <div class="user-dropdown-header">

                                    <div class="user-dropdown-avatar">
                                        @initial
                                    </div>

                                    <div>
                                        <div class="user-dropdown-name">
                                            @username
                                        </div>

                                        <div class="user-dropdown-role">
                                            @roleName
                                        </div>
                                    </div>

                                </div>


                                <div class="dropdown-divider"></div>


                                <a asp-controller="Account"
                                   asp-action="ChangePassword"
                                   class="dropdown-item user-menu-item">

                                    <i class="bi bi-key"></i>

                                    <div>
                                        <div class="user-menu-title">
                                            Ubah Password
                                        </div>

                                        <div class="user-menu-description">
                                            Ubah password akun Anda
                                        </div>
                                    </div>

                                </a>


                                <div class="dropdown-divider"></div>


                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">

                                    <button type="submit"
                                            class="dropdown-item user-menu-logout">

                                        <i class="bi bi-box-arrow-right"></i>

                                        <span>Logout</span>

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </header>


                <!-- CONTENT -->
                <main class="content-area">

                    @RenderBody()

                </main>


                <!-- FOOTER -->
                <footer class="app-footer">

                    <span>
                        © 2026 Building Proposal System
                    </span>

                    <span>
                        Building Proposal Management System
                    </span>

                </footer>

            </div>

        </div>
    }
    else
    {
        <!-- LAYOUT UNTUK USER YANG BELUM LOGIN -->

        <main>
            @RenderBody()
        </main>
    }


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>


    <script>

        document.addEventListener("DOMContentLoaded", function () {

        const toggle = document.getElementById("sidebarToggle");
        const sidebar = document.querySelector(".sidebar");

        if (toggle && sidebar) {

        toggle.addEventListener("click", function () {

        sidebar.classList.toggle("sidebar-collapsed");

        });

        }

        });

    </script>


    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>